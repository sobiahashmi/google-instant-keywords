{
  "name": "google-instant-keywords",
  "version": "1.0.0",
  "private": true,
  "description": "Personal, local tool that collects Google Instant keyword suggestions into an Excel file.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sample": "tsx scripts/sample-excel.ts",
    "postinstall": "npx playwright install chromium",
    "try": "tsx scripts/try-run.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
